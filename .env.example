# ---------------------------------------------------------------------------
# Vezriqen AI - environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site
NEXT_PUBLIC_SITE_URL=https://www.vezriqen.com

# Legal owner shown in the footer and legal pages (PRD 30.8/30.9 - do not
# hardcode an unverified owner; set this once the entity is confirmed).
NEXT_PUBLIC_LEGAL_OWNER="Vezriqen AI™"
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@vezriqen.com

# The approved founder photograph ships at /brand/founder.webp. Set this only to
# override it with a different approved image (PRD 30.6 - never a generated one).
# NEXT_PUBLIC_FOUNDER_PORTRAIT=/brand/founder.webp

# Where feedback is delivered. The form emails this inbox and stores nothing -
# no address, no message, no identifier (module ported from Meriqen). Falls back
# to NEXT_PUBLIC_LEGAL_CONTACT_EMAIL. Delivery uses EMAIL_PROVIDER_API_KEY
# below; with no key the form says plainly that it did not send.
FEEDBACK_EMAIL_TO=

# --- Supabase --------------------------------------------------------------
# Auth, database and file storage. Supabase signs the session, so there is no
# separate session secret and no second auth system to keep in step.
#
# Google OAuth client id/secret are configured in the Supabase dashboard
# (Authentication > Providers > Google), NOT here. Google Cloud must have
# https://<project-ref>.supabase.co/auth/v1/callback as an authorised redirect
# URI, and Supabase must list https://www.vezriqen.com/api/auth/google/callback
# under Authentication > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security - never expose to the browser and
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (PRD 22: provider abstraction, structured output) -------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override; defaults to a current Claude model.
# AI_MODEL=claude-sonnet-4-5

# --- Google Calendar (PRD 11, Milestone 6) ---------------------------------
# DELIBERATELY a different Google client from sign-in. The production sign-in
# client is PUBLISHED with only openid/email/profile; adding a sensitive
# Calendar scope to a published app before verification imposes a permanent
# user cap that cannot be reset. Calendar is therefore developed against a
# second Google Cloud project in Testing status.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://www.vezriqen.com/api/calendar/callback

# 32-byte key, base64, for AES-256-GCM encryption of stored OAuth tokens at
# rest (PRD 23). Generate with: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- Email reminders (PRD 12) ----------------------------------------------
# Without a key, reminders still appear in the in-app reminder centre and are
# recorded as not sent. They are never marked delivered.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Vezri <vezri@vezriqen.com>"

# Signs short-lived email action links (PRD 12, 23).
# Generate with: openssl rand -base64 32
EMAIL_ACTION_SIGNING_KEY=

# Shared secret for the reminder dispatch cron endpoint.
# Generate with: openssl rand -base64 32
CRON_SECRET=
