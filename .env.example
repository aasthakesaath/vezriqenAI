# ---------------------------------------------------------------------------
# Vezriqen AI - environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legal owner shown in the footer and legal pages (PRD 30.8/30.9 - do not
# hardcode an unverified owner; set this once the entity is confirmed).
NEXT_PUBLIC_LEGAL_OWNER="Vezriqen AI™"
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@vezriqen.com

# The approved founder photograph ships at /brand/founder.webp. Set this only to
# override it with a different approved image (PRD 30.6 - never a generated one).
# NEXT_PUBLIC_FOUNDER_PORTRAIT=/brand/founder.webp

# Feedback delivery destination (webhook or forwarding endpoint). Without this
# the feedback form returns a clear error instead of silently dropping messages.
FEEDBACK_WEBHOOK_URL=

# --- Milestone 2+ ----------------------------------------------------------

# Google OAuth (sign-in scopes only; Calendar is a separate consent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AUTH_SECRET=

# Google Calendar (requested only at the separate opt-in step)
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Database
DATABASE_URL=

# Object storage for uploaded plan documents
PLAN_STORAGE_BUCKET=
PLAN_STORAGE_REGION=
PLAN_STORAGE_ACCESS_KEY_ID=
PLAN_STORAGE_SECRET_ACCESS_KEY=

# AI provider (structured extraction; provider-abstracted per PRD 22)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Transactional email for reminders
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Vezri <vezri@vezriqen.com>"
